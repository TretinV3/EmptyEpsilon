
# Use Discord Activity Integration
# VITE_USE_DISCORD = true
# PUBLIC_CLIENT_ID =
# DISCORD_CLIENT_SECRET =

# Use an authoritative game server or client provided game
# VITE_SERVER_TYPE = 'server'
VITE_SERVER_TYPE = 'client'

# Only with VITE_SERVER_TYPE = 'client' :
# On client connection use WebRTC (P2P) or WebSockets proxy
# VITE_CONNECTION = 'RTC'
VITE_CONNECTION = 'proxy'
